# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Testing, type checking, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Matplotlib transient config/cache directories
/matplotlib-*
matplotlib-*

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment configuration
.env
.env.*
config/.env
config/.env.*
!config/.env.example

# Runtime databases and operational data
data/*.db
data/*.db-shm
data/*.db-wal
*.log
*.png

# TelkomCare scraper runtime artifacts (graph cache, status manifest, session cookies)
data/netcare_cache/

# Telkomsel Orbit scraper runtime artifacts (quota cache, status manifest)
data/orbit_cache/

# Local Netcare target catalog: holds the deployment's own circuit IDs, branch
# names, and facility addresses. The committed config/netcare_targets.csv.example
# carries the anonymous catalog instead.
/config/netcare_targets.csv

# Local Telkomsel Orbit modem catalog: holds private customer phone numbers and
# hardware IMEIs. The committed config/orbit_targets.csv.example carries the
# anonymous mock catalog instead.
/config/orbit_*.xlsx
/config/orbit_targets.csv

# Timestamped copies written before an in-place Orbit catalog edit. These carry the
# same private phone numbers and IMEIs as the catalog they came from, so they must
# never be committed.
/config/backups/

# Packaging, builds, and distributions
*.egg-info/
dist/
build/

# Operating system and IDE metadata
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Internal documentation and planning artifacts
/docs/


# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Testing, type checking, and coverage caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment configuration
.env
.env.*
!.env.example

# Runtime databases and operational data
data/*.db
data/*.db-shm
data/*.db-wal
*.log
*.png

# TelkomCare scraper runtime artifacts (graph cache, status manifest, session cookies)
data/netcare_cache/

# Local Netcare target catalog: holds the deployment's own circuit IDs, branch
# names, and facility addresses. The committed config/netcare_targets.csv.example
# carries the anonymous catalog instead.
/config/netcare_targets.csv

# Packaging, builds, and distributions
*.egg-info/
dist/
build/

# Operating system and IDE metadata
.DS_Store
Thumbs.db
*.swp
*.swo
.idea/
.vscode/

# Internal documentation and planning artifacts
/docs/


[Unit]
Description=MRTG-CMP MikroTik Traffic Collector Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@APP_USER@
Group=@APP_USER@
UMask=0077
WorkingDirectory=@APP_DIR@
EnvironmentFile=-@APP_DIR@/config/.env
EnvironmentFile=-@APP_DIR@/.env
RuntimeDirectory=mrtg-cmp-collector
RuntimeDirectoryMode=0700
Environment=MPLCONFIGDIR=/run/mrtg-cmp-collector/matplotlib
ExecStartPre=/usr/bin/mkdir -p /run/mrtg-cmp-collector/matplotlib
ExecStart=@APP_DIR@/.venv/bin/python -m mrtg_cmp collect
Restart=always
RestartSec=10s

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@APP_DIR@/data @APP_DIR@ /run/mrtg-cmp-collector

[Install]
WantedBy=multi-user.target

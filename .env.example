# ==============================================================================
# MRTG Traffic Monitor - Environment Configuration (.env)
# Copy this file to '.env' in the project root and configure your values.
# ==============================================================================

# Application branding and site identification.
# Both values are deliberately neutral: this file is the public template, so the
# site name is an operator-owned override in your private .env, not a default.
APP_NAME="MRTG Traffic Monitor"
SITE_NAME="Enterprise Gateway"
LOCATION_NAME="Branch Office"
UPLINK_NAME="Main Uplink (150 Mbps)"

# SQLite database file path (automatically created if not present)
DATABASE_PATH="data/traffic.db"

# ------------------------------------------------------------------------------
# APPLICATION LOGGING
# ------------------------------------------------------------------------------
# Log file destination. The directory is created on startup if it does not
# exist, and the file rotates at 5 MB keeping 5 generations. Leave empty to
# log to the console only.
LOG_FILE="logs/mrtg-cmp.log"

# Minimum level written to both the console and the log file:
# DEBUG, INFO, WARNING, ERROR, or CRITICAL
LOG_LEVEL="INFO"

# ------------------------------------------------------------------------------
# MIKROTIK ROUTEROS API CONNECTION
# ------------------------------------------------------------------------------
# RouterOS IP or tunnel domain (e.g. 192.168.88.1 or your tunnel host)
ROUTEROS_HOST="192.168.88.1"

# Remote/local port forwarded to RouterOS API (8728)
ROUTEROS_PORT=8728

# RouterOS username (requires 'read' group for monitoring)
ROUTEROS_USERNAME="mrtg"

# RouterOS user password
ROUTEROS_PASSWORD=""

# Monitored network interface name (e.g. WAN or ether1)
ROUTEROS_INTERFACE="WAN"

# ------------------------------------------------------------------------------
# DATA COLLECTION INTERVAL (COLLECTOR DAEMON)
# ------------------------------------------------------------------------------
# Polling interval in seconds (default: 60 seconds = 1 minute)
POLLING_INTERVAL=60

# ------------------------------------------------------------------------------
# WEB DASHBOARD (FASTAPI & UVICORN)
# ------------------------------------------------------------------------------
# Web server network bind address (0.0.0.0 to listen on all interfaces)
WEB_HOST="0.0.0.0"

# Web dashboard TCP port (default: 8000)
WEB_PORT=8000

# Secret key for cookie session encryption
SECRET_KEY="change-this-secret-key-in-production"

# Set true if deployed behind HTTPS/SSL, false for plain HTTP
SESSION_COOKIE_SECURE=false

# Standard web session lifetime in seconds (default: 28800 = 8 hours)
SESSION_TTL_SECONDS=28800

# Extended session lifetime when "Remember Me" is checked (default: 2592000 = 30 days)
REMEMBER_ME_TTL_SECONDS=2592000

# ------------------------------------------------------------------------------
# INITIAL WEB DASHBOARD ADMINISTRATOR
# ------------------------------------------------------------------------------
# Administrator username seeded upon 'mrtg-cmp init-db'
ADMIN_USERNAME="admin"

# Administrator password (if left empty, defaults to 'admin123')
ADMIN_PASSWORD=""

# ------------------------------------------------------------------------------
# TUNNEL.WEB.ID WATCHDOG & AUTO-HEALING (OPTIONAL)
# ------------------------------------------------------------------------------
# Credentials for member.tunnel.web.id for automated status inspection and restart
TUNNEL_WEB_EMAIL=""
TUNNEL_WEB_PASSWORD=""
TUNNEL_WEB_SERVICE_ID=""
TUNNEL_AUTO_RESTART=false
TUNNEL_RESTART_COOLDOWN_MINUTES=30

# ------------------------------------------------------------------------------
# WHATSAPP NOTIFICATION ALERTS (GOWA REST GATEWAY)
# ------------------------------------------------------------------------------
# Enable automated WhatsApp alerts when router/tunnel disconnects or recovers
WA_ALERT_ENABLED=false

# Local GOWA gateway address (default on Debian: http://localhost:3000)
WA_GATEWAY_URL="http://localhost:3000"

# GOWA paired Device ID (e.g. NOC-Bot)
WA_DEVICE_ID=""

# Destination WhatsApp JID (phone number '628xxx@s.whatsapp.net' or group 'xxx@g.us')
WA_TARGET_JID=""

# Consecutive polling failure cycles before triggering DOWN alert (default: 2 cycles = ~60s)
WA_FAIL_THRESHOLD=2

# ------------------------------------------------------------------------------
# TELKOMCARE NETCARE BRANCH GRAPH SCRAPER
# ------------------------------------------------------------------------------
# Run the scraper as a separate systemd unit (mrtg-cmp-netcare.service).
# Set false to keep the dashboard but stop scraping new graphs.
NETCARE_ENABLED=true

# TelkomCare MRTG portal base URL (no trailing slash)
NETCARE_BASE_URL="https://telkomcare.telkom.co.id"

# Seconds between full scrape rounds over all 18 branch targets
# (default: 300 = 5 minutes, matched to the dashboard auto-refresh)
NETCARE_POLL_INTERVAL_SECONDS=300

# Directory holding exactly one latest PNG per target plus status.json
NETCARE_CACHE_DIR="data/netcare_cache"

# Optional CSV catalog override with columns
# type,target,name,address,region,ocr_enabled
# Leave empty to use the built-in catalog of the 18 active branch links.
NETCARE_CATALOG_FILE=""

# Persistent browser profile so the portal session survives restarts
# (relative paths resolve under the application directory; ~ is expanded)
NETCARE_PROFILE_DIR="~/.mrtg-cmp-scraper-profile"

# Run Chrome headless (set false to watch the login flow locally)
NETCARE_HEADLESS=true

# Attempt the zero-touch login (credentials + Gemini CAPTCHA + TOTP) when
# cached cookies have expired. Set false to manage the session by hand once.
NETCARE_AUTO_LOGIN=true

# Selenium page/element timeouts in seconds
NETCARE_PAGE_TIMEOUT_SECONDS=30
NETCARE_GRAPH_TIMEOUT_SECONDS=25

# Number of parallel scraper worker threads (1-8). Each worker drives its own
# browser session, so 3 workers cut a full 18-branch round from ~150s to ~45s
# while keeping peak memory near 600 MB.
NETCARE_WORKERS=3

# ------------------------------------------------------------------------------
# GEMINI VISION CAPTCHA SOLVING (MULTI-KEY FAILOVER)
# ------------------------------------------------------------------------------
# Comma-separated Gemini API keys. On HTTP 429 quota exhaustion the solver
# rotates to the next key automatically, so more than one key is recommended.
# Gemini is only called when the TelkomCare session cookies have expired.
GEMINI_API_KEYS=""

# Comma-separated vision models tried in order until one returns a valid code.
# Only names in VALID_GEMINI_VISION_MODELS (netcare/captcha.py) are accepted;
# an unlisted name is 404'd and blacklists that request path.
# High-quota first: the two -flash-lite models carry the 500 RPD / 15 RPM quota,
# so routine logins answer in ~2s off the free tier instead of escalating to a
# metered model and stalling on its rate limit.
GEMINI_MODELS="gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.5-flash,gemini-3.6-flash,gemini-3.7-flash,gemini-3.8-flash,gemini-3-flash-preview"

# Gemini request timeout in seconds. Capped at 6 by the solver so a dead model
# fails fast instead of stalling the login; a model answering 404/503 is also
# blacklisted for the session, so later CAPTCHAs skip it entirely.
GEMINI_TIMEOUT_SECONDS=6

# ------------------------------------------------------------------------------
# TELKOMCARE PORTAL CREDENTIALS (ZERO-TOUCH AUTO-LOGIN)
# ------------------------------------------------------------------------------
TELKOM_USER=""
TELKOM_PASSWORD=""

# Base32 TOTP secret used to generate the 6-digit MFA code
TOTP_SECRET=""

# ------------------------------------------------------------------------------
# UNIFIED DASHBOARD
# ------------------------------------------------------------------------------
# Frontend auto-refresh interval in seconds with a visible countdown.
# MikroTik live polling stays at 30 seconds regardless of this value.
DASHBOARD_REFRESH_SECONDS=180
